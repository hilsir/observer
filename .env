# Порог уверенности для YOLO-детектора
CONF_THRESHOLD=0.20

# Цвета отрисовки (BGR для OpenCV)
# базовая линия разметки полки
COLOR_LINE=200,200,200
# точка-ориентир ожидаемой позиции товара
COLOR_DOT=0,0,255

# рамка товара: совпал с планом
COLOR_MATCH=0,255,0
# рамка товара: не тот/лишний
COLOR_MISMATCH=0,255,255
# рамка товара: не попал ни в одну линию разметки
COLOR_UNUSED=0,0,0

# текст названия товара под рамкой
COLOR_TEXT_NAME=255,255,255
# текст % уверенности модели под рамкой
COLOR_TEXT_CONFIDENCE=0,255,255

# % пустоты полки < 10
COLOR_VOID_LOW=0,255,0
# % пустоты полки < 40
COLOR_VOID_MID=0,255,255
# % пустоты полки >= 40
COLOR_VOID_HIGH=0,0,255

